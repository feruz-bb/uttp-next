# ETTP (uttp-next) — muhit o'zgaruvchilari namunasi.
# Nusxalang: cp .env.example .env.local  (Vercel'da: Project → Settings → Environment Variables)

# Supabase loyihasi: Project Settings → API → Project URL va anon (public) kalit.
# Lokal stack uchun: supabase start → URL http://127.0.0.1:54321, kalit «supabase status» chiqishida.
# «YOUR_...» placeholder qolsa tizim Supabase'siz demo-rejimda ishlaydi (faqat development).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Demo-rejim (localStorage auth, Supabase'siz).
# 0 — o'chiq: production'da Supabase sozlanmagan bo'lsa proxy.js har so'rovda xato beradi (deploy ochiq nosoz ko'rinadi).
# 1 — faqat ko'rgazma deploy uchun ataylab yoqiladi; real ma'lumot bilan ishlatilmaydi.
NEXT_PUBLIC_DEMO_MODE=0
